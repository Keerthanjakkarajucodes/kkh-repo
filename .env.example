GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# Optional: Fallback model if primary is unavailable (MoE variant: 26B total, 4B active)
GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it

# Optional: custom Gemini API base URL (for proxies or Vertex AI)
# GEMINI_BASE_URL=

# Development: set to 'true' to skip AI calls and use mock responses
# LINTCANVAS_DRY_RUN=false

# Timeout in ms for AI API calls (default: 60000)
# GEMINI_TIMEOUT=60000
